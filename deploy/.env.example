# EC-15 · Plantilla de configuración del servidor local.
# Copiar como .env en el servidor y llenar los valores. El archivo .env NUNCA se sube al repositorio.

# Base de datos
FRUTIS_DB_HOST=127.0.0.1
FRUTIS_DB_PORT=3306
FRUTIS_DB_NAME=frutis
FRUTIS_DB_USER=
FRUTIS_DB_PASSWORD=

# Middleware
FRUTIS_BIND_HOST=0.0.0.0
FRUTIS_PORT=8443
FRUTIS_CERT_PATH=
FRUTIS_KEY_PATH=
FRUTIS_JWT_SECRET=
FRUTIS_SESSION_MINUTES=60

# Facturación CFDI
FRUTIS_PAC_URL=
FRUTIS_PAC_USER=
FRUTIS_PAC_PASSWORD=
FRUTIS_CSD_CER_PATH=
FRUTIS_CSD_KEY_PATH=
FRUTIS_CSD_PASSWORD=
